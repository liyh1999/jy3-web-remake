{
  "name": "jy3-web-remake",
  "version": "0.1.0",
  "private": true,
  "description": "JY3 browser runtime and compatibility layer",
  "scripts": {
    "cache:offline": "node tools/vendor-upstream.mjs",
    "scan:resources": "node tools/scan-resources.mjs",
    "build:offline": "node tools/build-offline.mjs",
    "build": "npm run build:offline",
    "package": "npm run cache:offline && npm run scan:resources && npm run build:offline",
    "verify:offline": "node tools/verify-offline-dist.mjs",
    "serve:dist": "python3 -m http.server 8080 --directory dist --bind 0.0.0.0",
    "test:browser-compat": "node tools/e2e-browser-compat.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "release:verify": "node tools/verify-release-package.mjs",
    "release:package": "npm run package && npm run release:prepare && npm run release:verify"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
